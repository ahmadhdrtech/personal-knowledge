{
  "name": "neuron",
  "version": "0.2.0",
  "private": true,
  "description": "Personal knowledge graph: concepts from your sources, connected across topics, with bilingual tests, discussion and review.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "seed": "tsx scripts/seed.ts",
    "db:backup": "tsx scripts/backup.ts",
    "typecheck": "tsc --noEmit",
    "mcp:build": "tsx scripts/build-mcp.ts",
    "mcp": "node mcp/dist/neuron-mcp.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "d3": "7.9.2",
    "drizzle-orm": "0.45.4",
    "katex": "0.16.22",
    "mammoth": "1.13.0",
    "mermaid": "11.6.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ts-fsrs": "5.4.2",
    "unpdf": "1.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/d3": "7.4.3",
    "@types/katex": "0.16.7",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1"
}
